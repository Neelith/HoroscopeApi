{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/src/src.slnx",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/src/src.slnx",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/src/src.slnx"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "dotnet run: Local",
            "command": "dotnet",
            "type": "process",
            "args": [
                "run",
                "-lp",
                "Local",
                "--project",
                "${workspaceFolder}/src/HoroscopeApi.WebApi/HoroscopeApi.WebApi.csproj"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "dotnet run: Dev",
            "command": "dotnet",
            "type": "process",
            "args": [
                "run",
                "-lp",
                "Development",
                "--project",
                "${workspaceFolder}/src/HoroscopeApi.WebApi/HoroscopeApi.WebApi.csproj"
            ],
            "problemMatcher": "$msCompile"
        }
    ]
}