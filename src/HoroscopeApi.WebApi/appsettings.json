{
  "AllowedHosts": "*",
  "HuggingFace": {
    "ApiUrl": "https://router.huggingface.co",
    "Model": "meta-llama/Llama-3.1-8B-Instruct",
    "Temperature": 0.7,
    "TimeoutSeconds": 90
  },
  "ApiKeySettings": {
    "PrefixLenght": 8
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3} {TraceId} {ParentId} {SpanId}] {Message:lj} {NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  }
}
